# Base de données PostgreSQL (obligatoire) — Neon, Supabase, Railway…
# Exemple Neon : postgresql://user:pass@host-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Taille du pool de connexions PostgreSQL (défaut 5 — adapté aux plans serverless type Neon)
# PG_POOL_MAX=5

# GEMINI_API_KEY: clé pour le Conseiller IA (texte + voix). Optionnelle :
# sans clé, le chatbot bascule automatiquement sur des réponses scriptées.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL publique du site (sitemap, partages). Ex: https://concam-site.onrender.com
APP_URL="MY_APP_URL"

# SESSION_SECRET (min 24 caractères) : signature des cookies de session admin.
# OBLIGATOIRE sur Vercel (filesystem éphémère). En local sans cette variable,
# un secret persistant est généré dans data/.session_secret.
SESSION_SECRET="concam_change_in_production"

# BLOB_READ_WRITE_TOKEN (Vercel) : stockage Vercel Blob des médias téléversés
# depuis l'admin (Vercel → Storage → Create Blob Store). Sans ce token, les
# médias restent sur le disque local (non persistant en serverless).
# BLOB_READ_WRITE_TOKEN=""

# CRON_SECRET (Vercel, optionnel) : protège le cron quotidien de sauvegarde
# (/api/cron/backup) — Vercel l'envoie en en-tête Authorization: Bearer.
# CRON_SECRET=""

# --- Mots de passe initiaux des comptes admin (optionnels) ---
# À définir AVANT le premier démarrage ; sinon valeurs par défaut + avertissement console.
# SEED_ADMIN_PASSWORD=""
# SEED_EDITOR_PASSWORD=""
# SEED_SALES_PASSWORD=""

# --- Modèles Gemini (optionnels, si un nom par défaut n'existe pas sur votre clé) ---
# GEMINI_TEXT_MODEL="gemini-4-hydrogen"        # chatbot texte (JSON structuré)
# GEMINI_LIVE_MODEL="gemini-3.8-live"          # voix temps réel (WebSocket)
# GEMINI_STT_MODEL="gemini-3.5-transcribe"     # transcription vocale (fallback)
# GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts" # synthèse vocale (fallback)
